# Postgres (Neon)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js
# Both of these are 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth (Cloud Console -> Credentials -> OAuth client, type "Web application")
# Authorized redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the stored Google refresh token
TOKEN_ENCRYPTION_KEY=

# Anthropic (server-side only, never exposed to the client)
ANTHROPIC_API_KEY=

# Language model for quick capture: none | ollama | anthropic
# Dates, durations and kind are always parsed in code, never by a model.
# With "none" the app is fully usable and completely free.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b
LLM_TIMEOUT_MS=8000
