# Postgres (Neon)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js
# Both of these are 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth (Cloud Console -> Credentials -> OAuth client, type "Web application")
# Authorized redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the stored Google refresh token
TOKEN_ENCRYPTION_KEY=

# Anthropic (server-side only, never exposed to the client)
ANTHROPIC_API_KEY=
